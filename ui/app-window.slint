import { Button, VerticalBox, ScrollView, Palette } from "std-widgets.slint";

struct SyntaxText {
    text: string,
    color: brush,
    background: brush,
}

export component AppWindow inherits Window {
    title: "Comparer";
    maximized: true;
    preferred-width: 800px;
    preferred-height: 600px;

    in-out property <[SyntaxText]> syntax_text: [
        { text: "First Line", color: Colors.white, background: Colors.transparent },
        { text: "Second Line", color: Colors.white, background: Colors.transparent }
    ];

    // Property to track the left pane's width
    property <length> left_pane_width: 400px;

    // Callback to pass the dropped data-transfer payload and target side ("left" or "right") to the backend
    callback file-dropped(data-transfer, string);

    HorizontalLayout {
        spacing: 5px;
        padding: 5px;

        // --- LEFT PANE ---
        DropArea {
            width: root.left_pane_width;

            // Visual overlay when a file hovers over the left pane
            Rectangle {
                width: 100%;
                height: 100%;
                background: parent.has-drag ? Colors.rgba(0, 118, 255, 0.1) : Colors.transparent;
                z: 1; // Keep overlay above content
            }

            can-drop(event) => { return event.proposed-action; }
            dropped(event) => { root.file-dropped(event.data, "left"); return event.proposed-action; }

            ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    spacing: 0px;
                    alignment: start;

                    for item in root.syntax_text: Rectangle {
                        width: 100%;
                        height: 10px;
                        background: item.background;
                        Text {
                            text: item.text;
                            color: item.color;
                            font-size: 10px;
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }

        // --- RESIZER ---
        line-rectangle := Rectangle {
            width: 3px;
            background: touch.pressed || touch.has-hover ? Palette.accent-background : Palette.border;

            touch := TouchArea {
                mouse-cursor: ew-resize;
                moved => {
                    root.left_pane_width = max(
                        50px, 
                        min(
                            root.width - 50px, 
                            root.left_pane_width + self.mouse-x - self.pressed-x));
                }
            }
        }

        // --- RIGHT PANE ---
        DropArea {
            horizontal-stretch: 1;

            // Visual overlay when a file hovers over the right pane
            Rectangle {
                width: 100%;
                height: 100%;
                background: parent.has-drag ? Colors.rgba(0, 118, 255, 0.1) : Colors.transparent;
                z: 1;
            }

            can-drop(event) => { return event.proposed-action; }
            dropped(event) => { root.file-dropped(event.data, "right"); return event.proposed-action; }

            ScrollView {
                width: 100%;
                height: 100%;

                VerticalLayout {
                    spacing: 0px;
                    alignment: start;

                    for item in root.syntax_text: Rectangle {
                        width: 100%;
                        height: 20px;
                        background: item.background;
                        Text {
                            text: item.text;
                            color: item.color;
                            font-size: 14px;
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }
}
